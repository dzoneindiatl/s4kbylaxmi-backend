    renderCart();

    function renderCart() {
        var cartItems = JSON.parse(localStorage.getItem('cartItems')) || [];
        var $container = $('#checkout-cart-container');

        if (cartItems.length === 0) {
            $container.html('<p>Your cart is empty.</p>');
            $('#subtotal, #delivery, #discount, #total, .total, #yousave, #total-items, #total-bottom, #totalAmountPay').text('₹0');
            return;
        }

        let total = 0;
        let output = '<ul class="check-product-list">';
        let totalPriceWithoutDiscount = 0;
        let totalPrice = 0;
        let totalDiscountPrice = 0;

            cartItems.forEach(function (item, index) {
            let itemTotal = item.sellingPrice * item.quantity;
            total += itemTotal;
            totalDiscountPrice += (item.originalPrice-item.price)* item.quantity;

            output += `
            <li>
                <div class="cp-list-l">
                    <figure><img src="${item.image}" alt="${item.name}"></figure>
                    <span class="no-product">${item.quantity}</span>
                </div>
                <div class="cp-list-r">
                    <figcaption>
                        <h4>${item.name}</h4>
                        <!-- <p>Bundles</p> -->
                        <span>₹${item.sellingPrice}</span>
                    </figcaption>
                </div>
            </li>
            `;
            totalPrice += item.price;
            totalPriceWithoutDiscount += item.originalPrice;
        });
        output += '</ul>';
        $container.html(output);

        // Update Summary
        const delivery = 0;
        const discount = totalPriceWithoutDiscount-totalPrice;
        //const finalTotal = total + delivery - discount;
        const finalTotal = total + delivery;

        $('#subtotal').text(`₹${total.toLocaleString()}`);
        $('#delivery').text(`₹${delivery.toLocaleString()}`);
        $('#discount').text(`-₹${(Number(totalDiscountPrice) || 0).toLocaleString()}`);
        $('.total').text(`₹${finalTotal.toLocaleString()}`);
        $('.subTotal').text(`₹${finalTotal.toLocaleString()}`);
        $('#totalAmountPay').text(`₹${finalTotal.toLocaleString()}`);
        $('#yousave').text(`-₹${(Number(totalDiscountPrice) || 0).toLocaleString()}`);
        $('#total-items').text(cartItems.length);
    }
